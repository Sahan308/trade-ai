# Copy to .env and adjust. Never commit real secrets.
TRADEAI_ENV=development
# SQLite for local dev; Postgres example: postgresql+psycopg://tradeai:tradeai@localhost:5432/tradeai
TRADEAI_DATABASE_URL=sqlite:///./tradeai.db
# Comma-separated origins allowed to call the API from a browser
TRADEAI_CORS_ORIGINS=http://localhost:8080,https://sahan308.github.io
TRADEAI_LOG_LEVEL=INFO
